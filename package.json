{
  "name": "kore-assistant",
  "displayName": "Kore Assistant",
  "description": "An assistant that gives you powerful tools when working with Kore.",
  "version": "0.4.0",
  "publisher": "Ayfri",
  "icon": "dist/assets/kore.png",
  "license": "GPL-3.0",
  "author": {
    "name": "Ayfri",
    "url": "https://github.com/Ayfri"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kore-Minecraft/Kore-Assistant-VSCode"
  },
  "bugs": {
    "url": "https://github.com/Kore-Minecraft/Kore-Assistant-VSCode/issues"
  },
  "homepage": "https://github.com/Kore-Minecraft/Kore-Assistant-VSCode#readme",
  "keywords": [
    "kore",
    "minecraft",
    "datapack",
    "kotlin"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:kotlin"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "kore-assistant.refreshGutterIcons",
        "title": "Kore: Refresh Gutter Icons"
      },
      {
        "command": "kore-assistant.revealKoreElement",
        "title": "Kore: Reveal Element"
      },
      {
        "command": "kore-assistant.openDeclaration",
        "title": "Go to Declaration"
      },
      {
        "command": "kore-assistant.copyName",
        "title": "Copy Name"
      },
      {
        "command": "kore-assistant.copyNamespace",
        "title": "Copy Namespace"
      },
      {
        "command": "kore-assistant.copyResourceLocation",
        "title": "Copy Resource Location"
      },
      {
        "command": "kore-assistant.copyOutputPath",
        "title": "Copy Output Path"
      },
      {
        "command": "kore-assistant.copyCommand",
        "title": "Copy Command"
      },
      {
        "command": "kore-assistant.copyFilePath",
        "title": "Copy File Path"
      },
      {
        "command": "kore-assistant.copyDeclarationPath",
        "title": "Copy Declaration Path"
      },
      {
        "command": "kore-assistant.copyResourceLocations",
        "title": "Copy All Resource Locations"
      },
      {
        "command": "kore-assistant.copyOutputPaths",
        "title": "Copy All Output Paths"
      },
      {
        "command": "kore-assistant.selectGrouping",
        "title": "Kore: Group Explorer By...",
        "icon": "$(list-tree)"
      },
      {
        "command": "kore-assistant.selectSorting",
        "title": "Kore: Sort Explorer By...",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "kore-assistant.filter",
        "title": "Kore: Filter Explorer",
        "icon": "$(filter)"
      },
      {
        "command": "kore-assistant.clearFilter",
        "title": "Kore: Clear Explorer Filter",
        "icon": "$(filter-filled)"
      },
      {
        "command": "kore-assistant.refreshExplorer",
        "title": "Kore: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "kore-assistant.revealInExplorer",
        "title": "Kore: Reveal in Kore Explorer"
      }
    ],
    "snippets": [
      {
        "language": "kotlin",
        "path": "./snippets/kotlin.code-snippets"
      }
    ],
    "configuration": {
      "title": "Kore Assistant",
      "properties": {
        "kore-assistant.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report duplicate declarations, unresolved function commands and invalid craftingShaped patterns as problems."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kore-explorer",
          "title": "Kore Explorer",
          "icon": "dist/assets/kore-white.svg"
        }
      ]
    },
    "views": {
      "kore-explorer": [
        {
          "id": "koreExplorer",
          "icon": "dist/assets/kore-white.svg",
          "name": ""
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "kore-assistant.revealKoreElement", "when": "false" },
        { "command": "kore-assistant.openDeclaration", "when": "false" },
        { "command": "kore-assistant.copyName", "when": "false" },
        { "command": "kore-assistant.copyNamespace", "when": "false" },
        { "command": "kore-assistant.copyResourceLocation", "when": "false" },
        { "command": "kore-assistant.copyOutputPath", "when": "false" },
        { "command": "kore-assistant.copyCommand", "when": "false" },
        { "command": "kore-assistant.copyFilePath", "when": "false" },
        { "command": "kore-assistant.copyDeclarationPath", "when": "false" },
        { "command": "kore-assistant.copyResourceLocations", "when": "false" },
        { "command": "kore-assistant.copyOutputPaths", "when": "false" },
        { "command": "kore-assistant.clearFilter", "when": "koreFilterActive" },
        { "command": "kore-assistant.revealInExplorer", "when": "editorLangId == kotlin" }
      ],
      "editor/context": [
        {
          "command": "kore-assistant.revealInExplorer",
          "when": "editorLangId == kotlin",
          "group": "navigation@9"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "kore-assistant.revealInExplorer",
          "when": "editorLangId == kotlin",
          "group": "kore@1"
        }
      ],
      "view/title": [
        {
          "command": "kore-assistant.filter",
          "when": "view == koreExplorer && !koreFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "kore-assistant.clearFilter",
          "when": "view == koreExplorer && koreFilterActive",
          "group": "navigation@1"
        },
        {
          "command": "kore-assistant.selectGrouping",
          "when": "view == koreExplorer",
          "group": "navigation@2"
        },
        {
          "command": "kore-assistant.selectSorting",
          "when": "view == koreExplorer",
          "group": "navigation@3"
        },
        {
          "command": "kore-assistant.refreshExplorer",
          "when": "view == koreExplorer",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "kore-assistant.openDeclaration",
          "when": "view == koreExplorer && viewItem =~ /^(datapack|file) .*\\bdeclarationPath\\b/",
          "group": "navigation@1"
        },
        {
          "command": "kore-assistant.copyName",
          "when": "view == koreExplorer && viewItem =~ /\\bname\\b/",
          "group": "kore@1"
        },
        {
          "command": "kore-assistant.copyNamespace",
          "when": "view == koreExplorer && viewItem =~ /\\bnamespace\\b/",
          "group": "kore@2"
        },
        {
          "command": "kore-assistant.copyResourceLocation",
          "when": "view == koreExplorer && viewItem =~ /\\bresourceLocation\\b/",
          "group": "kore@3"
        },
        {
          "command": "kore-assistant.copyOutputPath",
          "when": "view == koreExplorer && viewItem =~ /\\boutputPath\\b/",
          "group": "kore@4"
        },
        {
          "command": "kore-assistant.copyCommand",
          "when": "view == koreExplorer && viewItem =~ /\\bcommand\\b/",
          "group": "kore@5"
        },
        {
          "command": "kore-assistant.copyResourceLocations",
          "when": "view == koreExplorer && viewItem =~ /\\bresourceLocations\\b/",
          "group": "korebulk@1"
        },
        {
          "command": "kore-assistant.copyOutputPaths",
          "when": "view == koreExplorer && viewItem =~ /\\boutputPaths\\b/",
          "group": "korebulk@2"
        },
        {
          "command": "kore-assistant.copyFilePath",
          "when": "view == koreExplorer && viewItem =~ /\\bfilePath\\b/",
          "group": "source@1"
        },
        {
          "command": "kore-assistant.copyDeclarationPath",
          "when": "view == koreExplorer && viewItem =~ /\\bdeclarationPath\\b/",
          "group": "source@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && tsdown --sourcemap",
    "watch": "bun run --parallel watch:tsdown watch:tsc",
    "watch:tsdown": "tsdown --sourcemap --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "bun run check-types && bun run lint && tsdown --minify",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
